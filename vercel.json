{
  "crons": [
    {
      "path": "/api/cron/monthly-updates",
      "schedule": "0 9 1 * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "devthru.com"
        }
      ],
      "destination": "https://www.devthru.com/:path*",
      "statusCode": 301
    }
  ]
}

